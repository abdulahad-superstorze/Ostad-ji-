rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow get: if true;
    }

    function isAuthorizedTeacher() {
      return request.auth != null && 
             request.auth.token.email == 'abdulahad.onr2@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Teacher profile
    match /teachers/{teacherId} {
      allow read, write: if isAuthorizedTeacher() && isValidId(teacherId);
    }

    // Students
    match /students/{studentId} {
      allow read, write: if isAuthorizedTeacher() && isValidId(studentId);
    }

    // Daily Attendance Records
    match /attendance/{attendanceId} {
      allow read, write: if isAuthorizedTeacher() && isValidId(attendanceId);
    }

    // Monthly Payment Records
    match /payments/{paymentId} {
      allow read, write: if isAuthorizedTeacher() && isValidId(paymentId);
    }
  }
}
